# Environment variables for Anonymous Feedback Collection System

# Flask/Application Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY='your_secret_key_here' # Change this to a strong, random key

# Database Configuration (PostgreSQL example for FormConfigDB)
DATABASE_URL_FORM_CONFIG="postgresql://user:password@host:port/database"

# Database Configuration (MongoDB example for FeedbackDataStore)
DATABASE_URL_FEEDBACK_DATA="mongodb://user:password@host:port/database"

# GCP Project ID
GCP_PROJECT_ID="your-gcp-project-id"

# Other service-specific environment variables can be added here
